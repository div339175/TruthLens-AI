# TruthLens AI Configuration

# Execution mode: 'real' (run actual PyTorch/Transformers pipeline) or 'demo' (clearly labelled mock demo mode)
MODEL_MODE=real

# Device configuration: 'auto', 'cpu', 'cuda', or 'mps'
DEVICE=auto

# NLP & Vision Model Backbones
TEXT_MODEL_NAME=distilbert-base-uncased
VISION_MODEL_NAME=resnet18

# Multimodal Fusion Type: 'concat' or 'cross_attention'
FUSION_TYPE=cross_attention

# Embedding and projection dimensions
TEXT_EMBED_DIM=768
VISION_EMBED_DIM=512
PROJECTION_DIM=256

# Classification Decision Policy
# If max probability < UNCERTAINTY_THRESHOLD, prediction is classified as UNCERTAIN
UNCERTAINTY_THRESHOLD=0.65

# Video frame uniform sampling count
VIDEO_SAMPLE_FRAMES=8

# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
